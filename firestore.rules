rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Users =====
    // Users can read their own profile. Anyone authenticated can read any profile
    // (needed for displaying farmer names/reviews). Only the owner can write.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete their own profile
    }

    // ===== Produce Listings =====
    // Anyone can read listings (marketplace is public).
    // Only authenticated users can create, and farmerUid must match their auth UID.
    // Only the listing owner can update or delete.
    match /produce/{produceId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.farmerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.category in ['Vegetables', 'Fruits', 'Grains', 'Tubers']
                    && request.resource.data.price is string
                    && request.resource.data.farmer is string
                    && request.resource.data.location is string
                    && request.resource.data.phone is string;
      allow update: if request.auth != null
                    && resource.data.farmerUid == request.auth.uid
                    && request.resource.data.farmerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.farmerUid == request.auth.uid;
    }

    // ===== Reviews =====
    // Anyone can read reviews (displayed on cards).
    // Authenticated users can create a review, but:
    //   - buyerUid must match their auth UID
    //   - rating must be between 1 and 5
    //   - Cannot review themselves
    // Reviews cannot be edited or deleted (prevents manipulation).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.farmerId is string
                    && request.resource.data.farmerId.size() > 0
                    && request.resource.data.farmerName is string
                    && request.resource.data.buyerName is string;
      allow update, delete: if false;
    }

    // ===== Orders (if stored in Firestore later) =====
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.buyerUid == request.auth.uid
                      || resource.data.farmerUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.buyerUid == request.auth.uid;
      allow update, delete: if false; // Only backend should modify orders
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
